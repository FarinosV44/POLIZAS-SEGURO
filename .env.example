# Copia este archivo a .env (nunca lo subas al repositorio) y rellena los valores.

# Base de datos PostgreSQL (obligatoria)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/polizas

# URL pública de la aplicación (obligatoria en producción; debe ser HTTPS)
APP_URL=http://localhost:3000

# Almacenamiento privado de documentos: carpeta fuera de public/, con copia de seguridad.
STORAGE_DIR=./datos/documentos

# Tamaño máximo por documento en MB
MAX_UPLOAD_MB=25

# --- Avisos push (Web Push / VAPID). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avisos@example.com

# --- Correo de respaldo (SMTP). Si se deja vacío, el correo queda «sin configurar».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PRAETORIA gestor de seguros <avisos@example.com>"

# --- Inteligencia artificial (extracción y asistente de siniestros). Si se deja vacío, la IA queda «sin configurar».
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Tarea programada por HTTP (opcional, alternativa al proceso worker)
CRON_SECRET=

# --- Copias de seguridad cifradas (AES-256-GCM). Genera la clave con: openssl rand -base64 32
# Guárdala también FUERA del servidor (gestor de contraseñas): sin ella no se puede restaurar.
COPIAS_CLAVE=
COPIAS_DIR=./copias
COPIAS_RETENCION_DIAS=30
COPIAS_HORA=3
